{
  "name": "pixeltown",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.minimal.config.js",
    "build": "vite build --config vite.minimal.config.js",
    "preview": "vite preview --config vite.minimal.config.js --host 127.0.0.1",
    "dev:all": "node scripts/dev-minimal.mjs",
    "setup": "npm install && npm --prefix colyseus install",
    "test:integration": "node tests/integration.mjs",
    "dev:remote": "vite --host 127.0.0.1 --port 5173 --strictPort --mode remote",
    "build:remote": "node scripts/build-minimal-frontend.mjs --remote",
    "build:legacy:remote": "vite build --mode remote",
    "dev:legacy": "node scripts/dev.mjs",
    "build:legacy": "vite build",
    "preview:legacy": "vite preview --host 127.0.0.1",
    "dev:minimal": "node scripts/dev-minimal.mjs",
    "start:minimal:pb": "node scripts/minimal-pocketbase.mjs",
    "start:minimal:game": "node scripts/start-minimal-game.mjs",
    "test:minimal:pb-restart": "node tests/minimal-pb-restart.mjs",
    "test:minimal:services": "node tests/minimal-services.mjs",
    "test:minimal:unit": "node --test colyseus/minimal/test/*.test.js minimal/game/tests/state.test.mjs minimal/game/tests/visual-update.test.mjs",
    "test:minimal:visual": "node tests/minimal-visual-update.mjs",
    "test:minimal:ui": "node minimal/game/tests/offline-ui.mjs",
    "test:minimal": "node tests/minimal-integration.mjs",
    "test:minimal:swap": "node tests/minimal-hotswap.mjs",
    "swap:minimal": "node scripts/swap-minimal-worker.mjs",
    "deploy:minimal:worker": "node scripts/deploy-minimal-worker.mjs",
    "deploy:minimal:frontend": "node scripts/deploy-minimal-frontend.mjs"
  },
  "dependencies": {
    "@colyseus/sdk": "0.18.4",
    "galmuri": "^2.40.3",
    "pocketbase": "^0.26.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "playwright-core": "^1.55.1"
  }
}
