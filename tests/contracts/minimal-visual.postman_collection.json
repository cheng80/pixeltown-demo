{
  "info": {
    "name": "Minimal visual release",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "https://pixeltown.fastmake.net"
    }
  ],
  "item": [
    {
      "name": "current",
      "request": {
        "method": "GET",
        "url": "{{base}}/visual/current.json"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"manifest and cache\",()=>{pm.response.to.have.status(200);pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");const m=pm.response.json();pm.expect(m.schema).to.eql(1);pm.expect(m.revision).to.match(/^[a-f0-9]{64}$/);pm.expect(m.compatibility).to.match(/^[a-f0-9]{64}$/);pm.expect(m.entry.startsWith(\"/visual/releases/\"+m.revision+\"/\")).to.eql(true);pm.expect(m.styles.length).to.be.above(0);pm.expect(m.fonts.length).to.eql(2);pm.expect(m.files.length).to.be.above(3);pm.collectionVariables.set(\"entry\",m.entry);pm.collectionVariables.set(\"style\",m.styles[0]);pm.collectionVariables.set(\"font\",m.fonts[0].url);});"
            ]
          }
        }
      ]
    },
    {
      "name": "renderer",
      "request": {
        "method": "GET",
        "url": "{{base}}{{entry}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"immutable renderer\",()=>{pm.response.to.have.status(200);pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"immutable\");pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"javascript\");pm.expect(pm.response.text()).to.include(\"createRenderer\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "style",
      "request": {
        "method": "GET",
        "url": "{{base}}{{style}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"immutable CSS\",()=>{pm.response.to.have.status(200);pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"css\");pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"immutable\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "font",
      "request": {
        "method": "GET",
        "url": "{{base}}{{font}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"immutable font\",()=>{pm.response.to.have.status(200);pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"immutable\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "missing",
      "request": {
        "method": "GET",
        "url": "{{base}}/visual/releases/missing/not-found.js"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"missing file is 404\",()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
